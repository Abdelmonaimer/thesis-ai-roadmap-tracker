# Provision Neon Postgres from the Vercel Marketplace; Vercel will add DATABASE_URL.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# A private, single-user sign-in password for this roadmap.
APP_PASSWORD=replace-with-a-long-private-password

# Generate a random secret, for example: openssl rand -base64 32
SESSION_SECRET=replace-with-at-least-32-random-characters
